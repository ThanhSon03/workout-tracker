CREATE TABLE IF NOT EXISTS habits (
    id       INTEGER PRIMARY KEY AUTOINCREMENT,
    name     TEXT    NOT NULL,
    emoji    TEXT    NOT NULL DEFAULT '',
    position INTEGER NOT NULL DEFAULT 0,
    weekdays TEXT    NOT NULL DEFAULT '${ke}',
    kind     TEXT    NOT NULL DEFAULT '${Ae}',
    rest_sec INTEGER NOT NULL DEFAULT 90
);

CREATE TABLE IF NOT EXISTS entries (
    habit_id INTEGER NOT NULL REFERENCES habits(id) ON DELETE CASCADE,
    day      TEXT    NOT NULL,
    PRIMARY KEY (habit_id, day)
);

CREATE TABLE IF NOT EXISTS wellness (
    day   TEXT PRIMARY KEY,
    mood  INTEGER,
    sleep REAL
);

CREATE TABLE IF NOT EXISTS skips (
    day    TEXT PRIMARY KEY,
    reason TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS notes (
    day  TEXT PRIMARY KEY,
    text TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS workout_logs (
    habit_id    INTEGER NOT NULL REFERENCES habits(id) ON DELETE CASCADE,
    day         TEXT    NOT NULL,
    sets        INTEGER NOT NULL DEFAULT 0,
    reps        INTEGER NOT NULL DEFAULT 0,
    weight      REAL    NOT NULL DEFAULT 0,
    rpe         REAL,
    note        TEXT    NOT NULL DEFAULT '',
    distance_km REAL,
    duration_min REAL,
    PRIMARY KEY (habit_id, day)
);

CREATE TABLE IF NOT EXISTS routines (
    id       INTEGER PRIMARY KEY AUTOINCREMENT,
    name     TEXT    NOT NULL,
    emoji    TEXT    NOT NULL DEFAULT '',
    position INTEGER NOT NULL DEFAULT 0,
    weekdays TEXT    NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS routine_items (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    routine_id  INTEGER NOT NULL REFERENCES routines(id) ON DELETE CASCADE,
    habit_id    INTEGER NOT NULL REFERENCES habits(id) ON DELETE CASCADE,
    position    INTEGER NOT NULL DEFAULT 0,
    target_sets INTEGER NOT NULL DEFAULT 3,
    target_reps INTEGER NOT NULL DEFAULT 8
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_routine_items_unique
    ON routine_items (routine_id, habit_id);

CREATE TABLE IF NOT EXISTS routine_sessions (
    routine_id  INTEGER NOT NULL REFERENCES routines(id) ON DELETE CASCADE,
    day         TEXT    NOT NULL,
    started_at  TEXT    NOT NULL,
    finished_at TEXT,
    PRIMARY KEY (routine_id, day)
);

CREATE TABLE IF NOT EXISTS deloads (
    week_start TEXT PRIMARY KEY,
    note       TEXT NOT NULL DEFAULT ''
);
